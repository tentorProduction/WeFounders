# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (rate limiting / anti-abuse)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Nepal Payment Gateways (TRD §4). Defaults run everything in sandbox mode:
# eSewa uses the public EPAYTEST merchant on rc-epay.esewa.com.np, and Khalti
# runs on test keys from https://test-admin.khalti.com/. With no
# KHALTI_SECRET_KEY at all, Khalti checkout is resolved by the local simulated
# gateway so the flow works fully offline. Set PAYMENTS_MODE=live (plus real
# credentials) for production.
PAYMENTS_MODE=sandbox
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# Transactional email
RESEND_API_KEY=

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
