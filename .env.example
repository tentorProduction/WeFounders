# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# `.env` (also gitignored) is loaded too, at lower precedence than `.env.local`.
# ---------------------------------------------------------------------------

# Supabase — project ref qxgrnbigvxwfrvllbagh (ap-south-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_: it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=
# Required server-only random secret, at least 32 bytes, for session signing.
SESSION_SECRET=

# Local development URL. Set production to https://wefounders.dev exactly.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional GA4 measurement ID (G-XXXXXXXXXX). Analytics stays off until enabled
# and each visitor opts in through the cookie preferences banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Upstash Redis is required in production for distributed write-rate limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Nepal Payment Gateways (TRD §4). Defaults run everything in sandbox mode:
# eSewa uses the public EPAYTEST merchant on rc-epay.esewa.com.np, and Khalti
# runs on test keys from https://test-admin.khalti.com/. The local Khalti
# simulator works only in development. Set PAYMENTS_MODE=live plus real
# credentials for production. Do not use sandbox credentials in production.
PAYMENTS_MODE=sandbox
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=

# Transactional email
RESEND_API_KEY=

# Firebase Auth (Google sign-in). These values are public identifiers shipped
# to the browser — they are safe in source, but keeping them in env lets you
# point at a different Firebase project without a rebuild.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
