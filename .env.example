# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# `.env` (also gitignored) is loaded too, at lower precedence than `.env.local`.
# ---------------------------------------------------------------------------

# Neon (serverless Postgres) — the application's only data store.
# Use the POOLED connection string: Neon Console → your project → Connection
# Details → "Pooled connection". The host ends in `-pooler`.
# The app never runs raw DDL; apply `db/schema.sql` once in the Neon
# SQL editor before first use, then check it with `npm run db:setup`.
DATABASE_URL=

# Clerk — sign-in.
# Clerk Dashboard → API Keys. The publishable key ships to the browser; the
# secret key is server-only and must never be prefixed with NEXT_PUBLIC_.
# Then Clerk Dashboard → User & Authentication → Sign-in methods → enable
# Google, and add your production domain to the allowed redirect/origin list.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk-hosted sign-in/sign-up. Leave as-is unless you move these routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/profile
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/submit

# Local development URL. Set production to https://wefounders.dev exactly.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional GA4 measurement ID (G-XXXXXXXXXX). Analytics stays off until enabled
# and each visitor opts in through the cookie preferences banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Upstash Redis is required in production for distributed write-rate limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Payment Gateways. Defaults run everything in sandbox mode:
# eSewa uses the public EPAYTEST merchant on rc-epay.esewa.com.np, and Khalti
# runs on test keys from https://test-admin.khalti.com/. The local Khalti
# simulator works only in development. Set PAYMENTS_MODE=live plus real
# credentials for production. Do not use sandbox credentials in production.
PAYMENTS_MODE=sandbox
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=

# Transactional email
RESEND_API_KEY=